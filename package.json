{
  "name": "chronos-electron-todo",
  "version": "1.0.0",
  "description": "Local Electron React SQLite todo list",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron:dev": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vite build",
    "dist": "pnpm build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.chronos.todo",
    "productName": "ToDoList_Electron",
    "asar": true,
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ToDoList_Electron.exe"
    }
  }
}
